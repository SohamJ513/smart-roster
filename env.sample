# Copy this file to `.env` and fill in the values. Never commit the real `.env` (it is in .gitignore).
# On a host such as Render, set these as environment variables in the dashboard instead of using a file.

# --- Database ---------------------------------------------------------------
# Local development: SQLite, a plain file, nothing to install.
DATABASE_URL=sqlite:///./roster.db
# Deployment: PostgreSQL (for example Neon). Paste the connection string exactly as the host gives it:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Server -----------------------------------------------------------------
# Port the server listens on. Hosting platforms usually set this for you.
PORT=8000

# --- Optional ---------------------------------------------------------------
# Folder holding the built frontend (defaults to frontend/dist).
# FRONTEND_DIST=./frontend/dist

# If set, POST /api/demo/reset only works with the header  X-Demo-Token: <this value>.
# Leave it unset to keep "Reset demo data" open for reviewers.
# DEMO_RESET_TOKEN=change-me
